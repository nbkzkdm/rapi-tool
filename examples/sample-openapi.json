{
  "openapi": "3.0.3",
  "info": {
    "title": "rapi sample JSON",
    "version": "1.0.0"
  },
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "pong",
            "content": {
              "application/json": {
                "examples": {
                  "default": {
                    "value": {
                      "pong": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "taro"
                  },
                  "age": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "example": {
                  "id": "u-1",
                  "name": "taro"
                }
              }
            }
          }
        }
      }
    }
  }
}
